# ── Production Domain Configuration ─────────────────────────
# Replace 'gym.yourdomain.com' with your actual domain or subdomain!
DOMAIN=gym.yourdomain.com
RP_ID=gym.yourdomain.com
ORIGIN=https://gym.yourdomain.com
RP_NAME=openGym

# ── Admin Settings ──────────────────────────────────────────
# Make the first registered profile an administrator
FIRST_USER_ADMIN=1

# Optional: set to 1 if you want to require invite codes for other users
INVITE_ONLY=0

# ── Security & System ───────────────────────────────────────
TRUST_PROXY=1
PORT=3000
